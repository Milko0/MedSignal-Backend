# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
APP_NAME=MedSignal API
CORS_ORIGINS=http://localhost:5173

# "memory": reference adapters over data/clean/*.jsonl (no databases needed). "databases": MongoDB + Redis.
STORAGE_BACKEND=memory
DATA_DIR=data/clean
CACHE_DIR=data/cache

# MongoDB. Host-run API: single node. Inside compose or on the lab: replica set URI.
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
MONGO_DB=medsignal

# Redis: single node, or Sentinel (when REDIS_SENTINELS is set it replaces REDIS_URL)
REDIS_URL=redis://localhost:6379/0
REDIS_SENTINELS=
REDIS_MASTER_NAME=mymaster

# Security (NFR-10): use a long random secret (32+ characters) outside local development
JWT_SECRET=change-me-change-me-change-me-32chars
JWT_EXPIRE_MINUTES=60

# External data (free key at open.fda.gov: much higher rate limits)
OPENFDA_API_KEY= 'WML79LnNfFttzDHJFnFnNmKC8gRGzC7b6g9hdPJP'
