# ---- application
ENVIRONMENT=local
JWT_SECRET=change-me-in-real-env
JWT_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173

# ---- MongoDB
# Host-run API against docker compose: direct connection to mongo1 (members advertise docker hostnames)
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# Inside the compose network or on the Virtual Lab use the full replica set:
# MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
MONGO_DB=medsignal

# ---- Redis: single node for local dev ...
REDIS_URL=redis://localhost:6379/0
# ... or Sentinel (compose network / Virtual Lab). Leave REDIS_SENTINELS empty for single node.
REDIS_SENTINELS=
REDIS_MASTER_NAME=mymaster

# ---- External APIs
OPENFDA_API_KEY=
