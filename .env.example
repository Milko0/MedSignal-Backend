# Copy to .env and adjust. Never commit .env (it is git-ignored).
ENVIRONMENT=local
APP_NAME=MedSignal API
CORS_ORIGINS=http://localhost:5173

# "memory": the dataset in DATA_DIR is loaded into RAM; accounts, follows and alerts are LOST on every restart
#           (and uvicorn --reload restarts on every code change).
# "databases": MongoDB + Redis, everything persists. Load the dataset once: python scripts/seed_databases.py --drop
STORAGE_BACKEND=databases
DATA_DIR=data/clean
CACHE_DIR=data/cache
FAERS_DIR=data/faers
# Rolling window: number of newest FAERS quarters kept (loading a new quarter drops the oldest)
FAERS_WINDOW_QUARTERS=6

# MongoDB. Host-run API: single node. Inside compose or on the lab: replica set URI.
MONGO_URI=mongodb://localhost:27017/?directConnection=true
# MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0
MONGO_DB=medsignal
# Analytics reads (statistics, signal explorer, trends) go to the secondaries; false = everything on the primary
MONGO_READ_SECONDARIES=true
MONGO_MAX_STALENESS_SECONDS=90

# Redis: single node (docker run -d --name redis -p 6379:6379 redis), or Sentinel (REDIS_SENTINELS replaces REDIS_URL)
REDIS_URL=redis://localhost:6379/0
REDIS_SENTINELS=
REDIS_MASTER_NAME=mymaster

# Tokens: use a random secret of at least 32 characters (each developer can pick their own)
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
JWT_EXPIRE_MINUTES=60

# External data. A free openFDA key (open.fda.gov) raises the rate limit; leave empty to run without one.
OPENFDA_API_KEY=
